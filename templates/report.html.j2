<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ row.ticker }} {{ stock.run_date }}: {{ final_rating }}</title>
{% include "_style.html.j2" %}
<style>
.layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 28px; max-width: 1180px; margin: 0 auto; padding: 24px; }
nav.side { position: sticky; top: 24px; align-self: start; }
nav.side a { display: block; padding: 6px 10px; border-radius: 8px; color: var(--ink-2); text-decoration: none; font-size: 14px; }
nav.side a:hover { background: var(--wash); color: var(--ink); }
nav.side .brand { font-weight: 700; color: var(--ink); padding: 0 10px 10px; }
header.top { margin-bottom: 16px; }
.facts { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; color: var(--ink-2); margin-top: 6px; }
.decision { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: start; }
.decision .big { font-size: 22px; padding: 8px 18px; }
.levels { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-top: 14px; }
.level { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
.level .k { font-size: 12px; color: var(--ink-2); }
.level .v { font-size: 17px; font-weight: 600; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
.tile { border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
.tile .k { font-size: 13px; color: var(--ink-2); }
.tile .v { font-size: 26px; font-weight: 650; line-height: 1.2; }
.tile .w { font-size: 12px; color: var(--ink-2); }
.meter { height: 6px; border-radius: 3px; background: var(--grid); margin-top: 8px; overflow: hidden; }
.meter > span { display: block; height: 100%; background: var(--s1); border-radius: 3px; }
.chart-box { position: relative; }
.chart-box svg { width: 100%; height: auto; display: block; overflow: visible; }
.chart-box text { font-size: 11px; fill: var(--muted); font-variant-numeric: tabular-nums; }
.chart-box .endlabel { fill: var(--ink-2); font-size: 11.5px; }
.legend { display: flex; flex-wrap: wrap; gap: 16px; font-size: 13px; color: var(--ink-2); margin: 0 0 8px; }
.legend i { display: inline-block; width: 16px; height: 2px; vertical-align: middle; margin-right: 6px; border-radius: 1px; }
.tip { position: absolute; pointer-events: none; background: var(--surface); border: 1px solid var(--border);
  border-radius: 8px; padding: 8px 10px; font-size: 12.5px; box-shadow: 0 4px 14px rgba(0,0,0,0.12); display: none; min-width: 150px; }
.tip .d { color: var(--ink-2); margin-bottom: 4px; }
.tip .r { display: flex; align-items: center; gap: 8px; }
.tip .r b { font-variant-numeric: tabular-nums; }
.tip .r i { width: 12px; height: 2px; display: inline-block; }
.tip .r span { color: var(--ink-2); }
.analyst { border-top: 1px solid var(--grid); padding-top: 14px; margin-top: 14px; }
.analyst:first-of-type { border-top: 0; margin-top: 0; padding-top: 0; }
.analyst .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
.analyst .score { font-weight: 650; }
.stance { font-size: 12px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border); color: var(--ink-2); }
details summary { cursor: pointer; color: var(--link); font-size: 14px; margin: 6px 0; }
.debate { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.side-col h3 { margin-top: 0; }
.abstain { color: var(--ink-2); font-style: italic; }
.vs { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.files li { font-size: 13px; }
@media (max-width: 900px) {
  .layout { grid-template-columns: minmax(0, 1fr); padding: 16px; gap: 12px; }
  nav.side { position: static; display: flex; gap: 4px; overflow-x: auto; padding-bottom: 4px; }
  nav.side .brand { display: none; }
  nav.side a { white-space: nowrap; }
  .decision { grid-template-columns: 1fr; }
  .debate { grid-template-columns: 1fr; }
  .card { padding: 16px; }
}
</style>
</head>
<body>
<div class="layout">
<nav class="side" aria-label="Sections">
  <div class="brand">{{ row.ticker }}</div>
  {% for id, label in sections %}<a href="#{{ id }}">{{ label }}</a>{% endfor %}
  <a href="../index.html">← {{ stock.run_date }} index</a>
</nav>

<main>
<header class="top">
  <div class="muted small">Stock Analyzer report · {{ stock.run_date }}</div>
  <h1>{{ company }} <span class="muted">({{ row.ticker }} · {{ row.exchange }})</span></h1>
  <div class="facts">
    <span class="num"><b>{{ data.price | num }}</b> {{ data.currency }} · close of {{ data.data_as_of }}</span>
    <span>{{ row.status }}</span>
    <span>Horizon: {{ row.horizon }} ({{ row.bucket }}-term)</span>
    <span>Risk: {{ row.risk_tolerance }}</span>
    <span>Depth: {{ stock.depth }}</span>
    {% if data.company.sector %}<span>{{ data.company.sector }}</span>{% endif %}
  </div>
</header>

<section id="decision" class="card">
  <div class="decision">
    <div>
      <span class="badge big {{ rating_class }}">{{ final_rating }}</span>
      <div style="margin-top:8px;font-weight:600">{{ action }}</div>
      {% if d.confidence is not none %}<div class="muted small">Confidence {{ d.confidence }}/100</div>{% endif %}
    </div>
    <div>
      {% if d.abstained %}
        <p class="abstain">The portfolio manager stage did not produce a decision: {{ d.reason }}. Review manually.</p>
      {% else %}
        <p style="margin:0 0 8px;font-size:16px">{{ d.summary }}</p>
        {% if d.since_last %}<p class="muted small" style="margin:0"><b>Since last report:</b> {{ d.since_last }}</p>{% endif %}
      {% endif %}
    </div>
  </div>
  {% if not d.abstained %}
  <div class="levels">
    <div class="level"><div class="k">Entry zone</div><div class="v num">{{ d.entry_zone or "n/a" }}</div></div>
    <div class="level"><div class="k">Target</div><div class="v num">{{ d.target | num }}</div>
      {% if d.target %}<div class="k num">{{ ((d.target / data.price) - 1) | pct }} from price</div>{% endif %}</div>
    <div class="level"><div class="k">Stop / review level</div><div class="v num">{{ d.stop | num }}</div>
      {% if d.stop %}<div class="k num">{{ ((d.stop / data.price) - 1) | pct }} from price</div>{% endif %}</div>
    {% if data.position %}
    <div class="level"><div class="k">Your position</div><div class="v num">{{ data.position.unrealized_pnl_pct | pct }}</div>
      <div class="k num">{{ data.position.qty | num(0) }} @ {{ data.position.avg_price | num }}</div></div>
    {% endif %}
  </div>
  <h3>Reasoning</h3>
  <div class="prose">{{ d.body_md | md }}</div>
  {% if d.what_changes_view %}
  <h3>What would change this view</h3>
  <ul>{% for t in d.what_changes_view %}<li>{{ t }}</li>{% endfor %}</ul>
  {% endif %}
  {% endif %}
  {% if second %}
  <p class="vs small" style="margin-top:12px"><span>2nd opinion (TradingAgents):</span>
    <span class="badge {{ rating_class_of(second.rating) }}">{{ second.rating }}</span>
    {% if second.agrees is sameas false %}<b>Disagrees with this report; read both.</b>{% elif second.agrees %}<span class="muted">Same direction.</span>{% endif %}
    <a href="#second">Details</a></p>
  {% endif %}
</section>

<section id="scores" class="card">
  <h2>Scores</h2>
  <div class="tiles">
    <div class="tile"><div class="k">Composite</div><div class="v num">{{ "%.1f" | format(comp.score) if comp.score is not none else "n/a" }}<span class="muted" style="font-size:14px">/10</span></div>
      <div class="w">Weighted for {{ row.bucket }}-term</div>
      {% if comp.score %}<div class="meter"><span style="width:{{ comp.score * 10 }}%"></span></div>{% endif %}</div>
    {% for a, o in analysts %}
    <div class="tile"><div class="k">{{ a | title }}</div>
      {% if o and not o.abstained %}
        <div class="v num">{{ o.score }}<span class="muted" style="font-size:14px">/10</span></div>
        <div class="w">{{ o.stance }} · weight {{ (comp.weights[a] * 100) | round | int }}%</div>
        <div class="meter"><span style="width:{{ o.score * 10 }}%"></span></div>
      {% else %}<div class="v muted">n/a</div><div class="w">abstained</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% if plan and not plan.abstained %}
  <p class="small" style="margin:14px 0 0">Research manager plan: <span class="badge {{ rating_class_of(plan.rating) }}">{{ plan.rating }}</span>
    <span class="muted">· debate won by {{ plan.winning_side }}</span></p>
  {% endif %}
</section>

<section id="chart" class="card">
  <h2>Price, 1 year <span class="muted small">({{ data.currency }})</span></h2>
  {% if chart %}
  <div class="legend" aria-hidden="true">
    <span><i style="background:var(--s1)"></i>Close</span>
    <span><i style="background:var(--s2)"></i>SMA 50</span>
    <span><i style="background:var(--s3)"></i>SMA 200</span>
    {% if chart.levels %}<span><i style="background:var(--ink-2)"></i>Target / stop</span>{% endif %}
  </div>
  <div class="chart-box" id="pc">
    <svg viewBox="0 0 {{ chart.W }} {{ chart.H }}" role="img" aria-label="{{ row.ticker }} closing price with 50 and 200 day averages over the last year">
      {% for t in chart.yticks %}
        <line x1="{{ chart.L }}" x2="{{ chart.W - chart.R }}" y1="{{ t.y }}" y2="{{ t.y }}" stroke="var(--grid)" stroke-width="1"/>
        <text x="{{ chart.L - 8 }}" y="{{ t.y + 4 }}" text-anchor="end">{{ t.label }}</text>
      {% endfor %}
      <line x1="{{ chart.L }}" x2="{{ chart.W - chart.R }}" y1="{{ chart.H - chart.B }}" y2="{{ chart.H - chart.B }}" stroke="var(--base)" stroke-width="1"/>
      {% for m in chart.months %}<text x="{{ m.x }}" y="{{ chart.H - 8 }}" text-anchor="middle">{{ m.label }}</text>{% endfor %}
      {% for l in chart.levels %}
        <line x1="{{ chart.L }}" x2="{{ chart.W - chart.R }}" y1="{{ l.y }}" y2="{{ l.y }}" stroke="var(--ink-2)" stroke-width="1" opacity="0.7"/>
        <text x="{{ chart.L + 6 }}" y="{{ l.y - 5 }}" class="endlabel">{{ l.label }} {{ l.value | num }}</text>
      {% endfor %}
      {% for s in chart.lines | reverse %}
        <path d="{{ s.d }}" fill="none" stroke="var(--s{{ s.slot }})" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
      {% endfor %}
      {% for s in chart.lines %}
        <circle cx="{{ s.end_x }}" cy="{{ s.end_y }}" r="4" fill="var(--s{{ s.slot }})" stroke="var(--surface)" stroke-width="2"/>
        <text x="{{ s.end_x + 9 }}" y="{{ s.label_y + 4 }}" class="endlabel">{{ s.label }} {{ s.end_v | num }}</text>
      {% endfor %}
      <line id="pc-x" y1="{{ chart.T }}" y2="{{ chart.H - chart.B }}" stroke="var(--ink-2)" stroke-width="1" visibility="hidden"/>
      <rect id="pc-hit" x="{{ chart.L }}" y="0" width="{{ chart.W - chart.L - chart.R }}" height="{{ chart.H }}" fill="transparent" tabindex="0" aria-label="Move across the chart for daily values"/>
    </svg>
    <svg viewBox="0 0 {{ chart.W }} {{ chart.VH + 4 }}" role="img" aria-label="Daily volume">
      <text x="{{ chart.L - 8 }}" y="12" text-anchor="end">Vol</text>
      {% for b in chart.bars %}<rect x="{{ '%.1f' % b.x }}" y="{{ '%.1f' % b.y }}" width="{{ '%.2f' % b.w }}" height="{{ '%.1f' % b.h }}" fill="var(--bar)"/>{% endfor %}
      <line x1="{{ chart.L }}" x2="{{ chart.W - chart.R }}" y1="{{ chart.VH }}" y2="{{ chart.VH }}" stroke="var(--base)" stroke-width="1"/>
    </svg>
    <div class="tip" id="pc-tip"></div>
  </div>
  <script type="application/json" id="pc-data">{{ chart.data | tojson_safe }}</script>
  {% else %}<p class="muted">Not enough price history to chart.</p>{% endif %}
</section>

{% if stock.previous or stock.lessons or reflections %}
<section id="memory" class="card">
  <h2>Since last report &amp; lessons</h2>
  {% if stock.previous %}
  <p>Last report <b>{{ stock.previous.Date }}</b>: <span class="badge {{ rating_class_of(stock.previous.Rating) }}">{{ stock.previous.Rating }}</span>
    ({{ stock.previous.Action }}) at <span class="num">{{ stock.previous.Price | num }}</span>; now <span class="num">{{ data.price | num }}</span>
    ({{ ((data.price / stock.previous.Price) - 1) | pct if stock.previous.Price else "n/a" }}).</p>
  {% else %}<p class="muted">First report for this stock.</p>{% endif %}
  {% if reflections %}
  <h3>Calls settled today</h3>
  <div class="table-wrap"><table>
    <tr><th>Call</th><th>Rating</th><th>Return</th><th>Alpha</th><th>Outcome</th><th>Lesson</th></tr>
    {% for p in reflections %}
    <tr><td class="num">{{ p.date }}</td><td><span class="badge {{ rating_class_of(p.rating) }}">{{ p.rating }}</span></td>
      <td class="num">{{ p.raw_return | pct }}</td><td class="num">{{ p.alpha | pct }}</td><td>{{ p.outcome }}</td>
      <td>{{ p.lesson or "(no lesson written)" }}</td></tr>
    {% endfor %}
  </table></div>
  {% endif %}
  {% if stock.lessons %}
  <h3>Earlier lessons for this stock</h3>
  <ul>{% for l in stock.lessons %}<li><b>{{ l.date }}</b> ({{ l.rating }}, {{ l.outcome }}): {{ l.lesson }}</li>{% endfor %}</ul>
  {% endif %}
</section>
{% endif %}

<section id="analysts" class="card">
  <h2>Analyst team</h2>
  {% for a, o in analysts %}
  <div class="analyst">
    <div class="head"><h3 style="margin:0">{{ a | title }}</h3>
      {% if o and not o.abstained %}<span class="score num">{{ o.score }}/10</span><span class="stance">{{ o.stance }}</span>{% endif %}</div>
    {% if not o %}<p class="abstain">Not run.</p>
    {% elif o.abstained %}<p class="abstain">Abstained: {{ o.reason }}</p>
    {% else %}
      <p style="margin:6px 0">{{ o.summary }}</p>
      <ul>{% for k in o.key_points %}<li>{{ k }}</li>{% endfor %}</ul>
      <details><summary>Full {{ a }} analysis</summary><div class="prose">{{ o.body_md | md }}</div></details>
    {% endif %}
  </div>
  {% endfor %}
</section>

{% if personas %}
<section id="personas" class="card">
  <h2>Investor personas</h2>
  <p class="muted small">Stylised lenses inspired by well-known investors' public philosophies; not the real people.</p>
  <div class="table-wrap"><table>
    <tr><th>Lens</th><th>Signal</th><th>Confidence</th><th>Reasoning</th></tr>
    {% for name, o in personas %}
    <tr><td><b>{{ name | title }}</b></td>
      {% if o.abstained %}<td colspan="3" class="abstain">Abstained: {{ o.reason }}</td>
      {% else %}<td>{{ o.signal }}</td><td class="num">{{ o.confidence }}</td><td>{{ o.reasoning }}</td>{% endif %}</tr>
    {% endfor %}
  </table></div>
</section>
{% endif %}

{% if debate %}
<section id="debate" class="card">
  <h2>Bull vs bear</h2>
  {% set rounds = debate | map(attribute=1) | unique | list %}
  {% for r in rounds %}
  {% if rounds | length > 1 %}<h3>Round {{ r }}</h3>{% endif %}
  <div class="debate">
    {% for side, rr, o in debate if rr == r %}
    <div class="side-col"><h3>{{ side | title }}</h3>
      {% if o.abstained %}<p class="abstain">Abstained: {{ o.reason }}</p>{% else %}<div class="prose">{{ o.argument_md | md }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  {% if plan %}
  <h3>Research manager's verdict</h3>
  {% if plan.abstained %}<p class="abstain">Abstained: {{ plan.reason }}</p>
  {% else %}<p><span class="badge {{ rating_class_of(plan.rating) }}">{{ plan.rating }}</span> {{ plan.summary }}</p>
  <div class="prose">{{ plan.plan_md | md }}</div>{% endif %}
  {% endif %}
</section>
{% endif %}

{% if risks %}
<section id="risk" class="card">
  <h2>Risk review</h2>
  {% for name, o in risks %}
  <h3>{{ name | title }}{% if not o.abstained %} <span class="stance">{{ o.stance }}</span>{% endif %}</h3>
  {% if o.abstained %}<p class="abstain">Abstained: {{ o.reason }}</p>
  {% else %}<p>{{ o.summary }}</p><ul>{% for x in o.recommendations %}<li>{{ x }}</li>{% endfor %}</ul>
  <details><summary>Reasoning</summary><div class="prose">{{ o.body_md | md }}</div></details>{% endif %}
  {% endfor %}
</section>
{% endif %}

{% if second %}
<section id="second" class="card">
  <h2>2nd opinion: TradingAgents</h2>
  {% if second.error %}<p class="abstain">TradingAgents did not finish: {{ second.error }}</p>
  {% else %}
  <p>TradingAgents rated this <span class="badge {{ rating_class_of(second.rating) }}">{{ second.rating }}</span>
    {% if second.agrees is sameas false %}<b>which disagrees in direction with this report ({{ final_rating }}).</b>{% elif second.agrees %}, the same direction as this report.{% endif %}</p>
  {% if second.excerpt %}<div class="prose">{{ second.excerpt | md }}</div>{% endif %}
  {% if second.href %}<p><a href="{{ second.href }}">Open the full TradingAgents report</a></p>{% endif %}
  {% endif %}
</section>
{% endif %}

<section id="data" class="card">
  <h2>Data used</h2>
  <div class="table-wrap"><table>
    <tr><th>Metric</th><th>Value</th><th>Metric</th><th>Value</th></tr>
    {% set t = data.technicals %}{% set f = data.fundamentals %}
    <tr><td>RSI 14</td><td class="num">{{ t.rsi14 | num(1) }}</td><td>P/E (trailing / forward)</td><td class="num">{{ f.pe_ratio | num(1) }} / {{ f.forward_pe | num(1) }}</td></tr>
    <tr><td>SMA 50 / 200</td><td class="num">{{ t.sma50 | num }} / {{ t.sma200 | num }}</td><td>PEG</td><td class="num">{{ f.peg_ratio | num }}</td></tr>
    <tr><td>ATR 14</td><td class="num">{{ t.atr14 | num }} ({{ t.atr_pct | pct(false) }})</td><td>Revenue growth</td><td class="num">{{ f.revenue_growth | pct }}</td></tr>
    <tr><td>52-week range</td><td class="num">{{ t.low_52w | num }} – {{ t.high_52w | num }}</td><td>Profit margin</td><td class="num">{{ f.profit_margin | pct(false) }}</td></tr>
    <tr><td>Return 1M / 6M / 1Y</td><td class="num">{{ t.returns["1M"] | pct }} / {{ t.returns["6M"] | pct }} / {{ t.returns["1Y"] | pct }}</td><td>Debt / equity</td><td class="num">{{ f.debt_to_equity | num(1) }}</td></tr>
    <tr><td>vs {{ data.market_context.benchmark }} 1Y</td><td class="num">{{ (t.relative_strength or {}).get("1Y") | pct }}</td><td>Market cap</td><td class="num">{{ f.market_cap | num }}</td></tr>
    <tr><td>{{ data.market_context.volatility_index }}</td><td class="num">{{ data.market_context.volatility_index_level | num }}</td><td>Dividend yield</td><td class="num">{{ f.dividend_yield_pct | num }}%</td></tr>
  </table></div>
  {% if data.news %}
  <h3>Headlines considered</h3>
  <ul class="small">{% for n in data.news %}<li><span class="num">{{ n.date }}</span> · {{ n.publisher }} · {% if n.link %}<a href="{{ n.link }}" rel="noopener noreferrer">{{ n.title }}</a>{% else %}{{ n.title }}{% endif %}</li>{% endfor %}</ul>
  {% endif %}
  {% if data.enrichment %}<h3>Extra data gathered by the agent</h3><div class="prose small">{{ (data.enrichment if data.enrichment is string else (data.enrichment | tojson)) | md }}</div>{% endif %}
  <p class="muted small">Source: {{ data.provider }} via OpenBB / Yahoo Finance, news via Yahoo and Google News. Fetched {{ data.fetched_at }}.
    {% if data.data_gaps %}Unavailable: {{ data.data_gaps | join(", ") }}.{% endif %} {{ data.notes | join(" ") }}</p>
</section>

<section id="files" class="card">
  <h2>Prompts &amp; outputs</h2>
  <p class="muted small">Every prompt exactly as used, and each stage's raw output.</p>
  <ul class="files">
    <li><a href="data.json">data.json</a> (market data snapshot) · <a href="stock.json">stock.json</a> (your row, settings, history)</li>
    {% for f, has_out in prompt_files %}
    <li><a href="prompts/{{ f }}">{{ f[:-3] | replace("__", "/") }}</a>{% if has_out %} · <a href="outputs/{{ f[:-3] }}.json">output</a>{% endif %}</li>
    {% endfor %}
  </ul>
  <p class="disclaimer">Generated {{ generated }} by Stock Analyzer. This is AI-generated research for information only. It is not investment advice, it can be wrong, and past performance does not predict future results. Make your own decisions or consult a licensed adviser.</p>
</section>
</main>
</div>

{% if chart %}
<script>
(function () {
  var data = JSON.parse(document.getElementById("pc-data").textContent);
  var box = document.getElementById("pc"), svg = box.querySelector("svg");
  var hit = document.getElementById("pc-hit"), xh = document.getElementById("pc-x"), tip = document.getElementById("pc-tip");
  var series = [["close", "Close", "var(--s1)"], ["sma50", "SMA 50", "var(--s2)"], ["sma200", "SMA 200", "var(--s3)"]];
  var fmt = function (v, d) { return v == null ? "n/a" : Number(v).toLocaleString(undefined, {minimumFractionDigits: d, maximumFractionDigits: d}); };
  function show(i) {
    var x = data.L + i * (data.W - data.L - data.R) / (data.n - 1);
    xh.setAttribute("x1", x); xh.setAttribute("x2", x); xh.setAttribute("visibility", "visible");
    tip.textContent = "";
    var d = document.createElement("div"); d.className = "d"; d.textContent = data.dates[i]; tip.appendChild(d);
    series.forEach(function (s) {
      var r = document.createElement("div"); r.className = "r";
      var k = document.createElement("i"); k.style.background = s[2];
      var b = document.createElement("b"); b.textContent = fmt(data[s[0]][i], 2);
      var l = document.createElement("span"); l.textContent = s[1];
      r.appendChild(k); r.appendChild(b); r.appendChild(l); tip.appendChild(r);
    });
    var v = document.createElement("div"); v.className = "r";
    var vb = document.createElement("b"); vb.textContent = fmt(data.volume[i], 0);
    var vl = document.createElement("span"); vl.textContent = "Volume";
    v.appendChild(document.createElement("i")); v.appendChild(vb); v.appendChild(vl); tip.appendChild(v);
    tip.style.display = "block";
    var scale = svg.getBoundingClientRect().width / data.W;
    var px = x * scale, w = tip.offsetWidth;
    tip.style.left = (px + 14 + w > box.clientWidth ? px - w - 14 : px + 14) + "px";
    tip.style.top = "10px";
  }
  function at(evt) {
    var pt = svg.createSVGPoint(); pt.x = evt.clientX; pt.y = evt.clientY;
    var p = pt.matrixTransform(svg.getScreenCTM().inverse());
    var i = Math.round((p.x - data.L) / ((data.W - data.L - data.R) / (data.n - 1)));
    return Math.max(0, Math.min(data.n - 1, i));
  }
  var cur = data.n - 1;
  hit.addEventListener("pointermove", function (e) { cur = at(e); show(cur); });
  hit.addEventListener("pointerleave", function () { tip.style.display = "none"; xh.setAttribute("visibility", "hidden"); });
  hit.addEventListener("focus", function () { show(cur); });
  hit.addEventListener("blur", function () { tip.style.display = "none"; xh.setAttribute("visibility", "hidden"); });
  hit.addEventListener("keydown", function (e) {
    if (e.key === "ArrowLeft") { cur = Math.max(0, cur - 1); show(cur); e.preventDefault(); }
    if (e.key === "ArrowRight") { cur = Math.min(data.n - 1, cur + 1); show(cur); e.preventDefault(); }
  });
})();
</script>
{% endif %}
</body>
</html>
