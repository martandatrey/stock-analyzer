<style>
:root {
  color-scheme: light;
  --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
  --grid: #e1e0d9; --base: #c3c2b7; --border: rgba(11,11,11,0.10); --wash: rgba(11,11,11,0.04);
  --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --bar: #86b6ef; --link: #1c5cab;
  --buy-bg: #1c5cab; --buy-fg: #ffffff; --ow-bg: #cde2fb; --ow-fg: #0d366b;
  --hold-bg: #f0efec; --hold-fg: #0b0b0b; --uw-bg: #f9d3d0; --uw-fg: #7a1c1c;
  --sell-bg: #c93a39; --sell-fg: #ffffff; --rev-bg: #e1e0d9; --rev-fg: #52514e;
  --up: #006300; --down: #b42f2f;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --page: #0d0d0d; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
    --grid: #2c2c2a; --base: #383835; --border: rgba(255,255,255,0.10); --wash: rgba(255,255,255,0.05);
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --bar: #256abf; --link: #86b6ef;
    --buy-bg: #3987e5; --buy-fg: #0b0b0b; --ow-bg: #184f95; --ow-fg: #cde2fb;
    --hold-bg: #383835; --hold-fg: #f0efec; --uw-bg: #5c2524; --uw-fg: #f9d3d0;
    --sell-bg: #e66767; --sell-fg: #0b0b0b; --rev-bg: #2c2c2a; --rev-fg: #c3c2b7;
    --up: #0ca30c; --down: #e66767;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
  --grid: #2c2c2a; --base: #383835; --border: rgba(255,255,255,0.10); --wash: rgba(255,255,255,0.05);
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --bar: #256abf; --link: #86b6ef;
  --buy-bg: #3987e5; --buy-fg: #0b0b0b; --ow-bg: #184f95; --ow-fg: #cde2fb;
  --hold-bg: #383835; --hold-fg: #f0efec; --uw-bg: #5c2524; --uw-fg: #f9d3d0;
  --sell-bg: #e66767; --sell-fg: #0b0b0b; --rev-bg: #2c2c2a; --rev-fg: #c3c2b7;
  --up: #0ca30c; --down: #e66767;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body { margin: 0; background: var(--page); color: var(--ink);
  font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
a { color: var(--link); }
h1 { font-size: 26px; line-height: 1.2; margin: 0 0 4px; }
h2 { font-size: 19px; margin: 0 0 12px; }
h3 { font-size: 16px; margin: 18px 0 6px; }
.muted { color: var(--ink-2); }
.small { font-size: 13px; }
.num { font-variant-numeric: tabular-nums; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin: 0 0 16px; }
.badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-weight: 600; font-size: 13px; white-space: nowrap; }
.r-buy { background: var(--buy-bg); color: var(--buy-fg); }
.r-ow { background: var(--ow-bg); color: var(--ow-fg); }
.r-hold { background: var(--hold-bg); color: var(--hold-fg); box-shadow: inset 0 0 0 1px var(--border); }
.r-uw { background: var(--uw-bg); color: var(--uw-fg); }
.r-sell { background: var(--sell-bg); color: var(--sell-fg); }
.r-review { background: var(--rev-bg); color: var(--rev-fg); }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { text-align: left; padding: 7px 10px 7px 0; border-bottom: 1px solid var(--grid); vertical-align: top; }
th { color: var(--ink-2); font-weight: 600; font-size: 13px; }
.table-wrap { overflow-x: auto; }
.disclaimer { font-size: 13px; color: var(--ink-2); border-top: 1px solid var(--grid); padding-top: 12px; margin-top: 24px; }
.prose p { margin: 0 0 10px; }
.prose ul { margin: 0 0 10px; padding-left: 20px; }
</style>
